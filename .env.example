# Environment variables for backend
POSTGRES_PASSWORD=password
POSTGRES_DB=db
DATABASE_URL="postgresql://postgres:password@localhost:5432/db?schema=public"

# Cloudinary (crear cuenta free en cloudinary.com > Dashboard > Api Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Token compartido para las rutas /api/admin/** (header x-admin-token).
# Generar uno propio: openssl rand -hex 32
ADMIN_API_TOKEN=


# Stripe test mode (dashboard.stripe.com/test/apikeys).
# La secret key SOLO va en el servidor; la publishable key se expone al cliente.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secreto del webhook: local sale de `stripe listen`, en prod del endpoint
# Dashboard Stripe > Developers > Webhooks. Solo servidor, nunca commitear el valor.
STRIPE_WEBHOOK_SECRET=

# ── Email transaccional (Resend) ─────────────────────────────────────────────
# Pasos para activar:
#  1. Crear cuenta free en https://resend.com  (3.000 emails/mes gratis)
#  2. Ir a Resend Dashboard → API Keys → Create API Key
#  3. Ir a Resend Dashboard → Domains → Add Domain (verificar DNS de tu dominio)
#  4. Pegar los valores aquí y en tu .env de producción
#
# Sin estas variables, los emails se imprimen en la consola del servidor (modo stub).
RESEND_API_KEY=
EMAIL_FROM=noreply@tudominio.com

# URL pública de la app (usado en enlaces dentro de los emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
