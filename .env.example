# Environment variables for backend
POSTGRES_PASSWORD=password
POSTGRES_DB=db
DATABASE_URL="postgresql://postgres:password@localhost:5432/db?schema=public"

# Cloudinary (crear cuenta free en cloudinary.com > Dashboard > Api Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Token compartido para las rutas /api/admin/** (header x-admin-token).
# Generar uno propio: openssl rand -hex 32
ADMIN_API_TOKEN=


# Stripe test mode (dashboard.stripe.com/test/apikeys).
# La secret key SOLO va en el servidor; la publishable key se expone al cliente.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
